  {
    "id": "coursev1_normalize",
    "type": "function",
    "z": "coursev1_flow",
    "name": "Prepare readings for dashboard",
    "func": "// Converts MQTT values into a consistent format for the dashboard.\n// Supported topics: home/temperature, sensor/temperature,\n// home/humidity, sensor/humidity, or home/sensors (JSON).\nlet data = msg.payload\n\nif (Buffer.isBuffer(data)) data = data.toString()\nif (typeof data === 'string') {\n    try { data = JSON.parse(data) }\n    catch (error) { data = Number(data) }\n}\n\nlet temperature = null\nlet humidity = null\nconst topic = msg.topic || ''\n\nif (data && typeof data === 'object' && !Array.isArray(data)) {\n    temperature = data.temperature ?? null\n    humidity = data.humidity ?? null\n} else if (topic.endsWith('/temperature')) {\n    temperature = data\n} else if (topic.endsWith('/humidity')) {\n    humidity = data\n} else {\n    return null\n}\n\nfunction valid(value, min, max) {\n    return value !== null && value !== '' && Number.isFinite(Number(value))\n        && Number(value) >= min && Number(value) <= max\n}\n\nconst hasTemperature = valid(temperature, -30, 80)\nconst hasHumidity = valid(humidity, 0, 100)\nif (!hasTemperature && !hasHumidity) return null\n\nmsg.payload = {\n    interfaceV1: true,\n    temperature: hasTemperature ? Number(temperature) : null,\n    humidity: hasHumidity ? Number(humidity) : null,\n    source: topic === 'test/readings' ? 'test' : 'live'\n}\nreturn msg\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 490,
    "y": 180,
    "wires": [
      [
        "coursev1_ui",
        "coursev1_debug"
      ]
    ]
  },
  {
    "id": "coursev1_debug",
